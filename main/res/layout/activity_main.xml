<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_shape"
    android:id="@+id/MainLayout"
    tools:context=".MainActivity">
      <TextView
          android:id="@+id/text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="دفتر الحسابات"
          android:textStyle="bold"
          android:textColor="@color/black"
          android:layout_marginRight="20dp"
          android:textSize="20sp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintRight_toRightOf="parent" />
      <androidx.cardview.widget.CardView
          android:id="@+id/cardTotal1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          app:cardElevation="5dp"
          android:layout_marginHorizontal="20dp"
          app:layout_constraintRight_toRightOf="parent"
          app:layout_constraintLeft_toLeftOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text"
          app:cardBackgroundColor="@color/green"
          app:cardCornerRadius="25dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
               >

                  <TextView
                      android:id="@+id/txtCount"
                      android:layout_width="140dp"
                      android:layout_height="115dp"
                      android:layout_marginTop="-35dp"
                      android:background="@drawable/count_shape"
                      android:gravity="bottom"
                      android:paddingBottom="30dp"
                      android:paddingRight="25dp"
                      android:text="عدد الزبائن: 0"
                      android:textColor="@color/green"
                      android:textSize="18sp"
                      android:textStyle="bold"
                      app:layout_constraintLeft_toLeftOf="parent"
                      app:layout_constraintTop_toTopOf="parent" />


                  <TextView
                      android:id="@+id/txtTotal"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="اجمالي المبلغ غير المدفوع "
                      android:textColor="@color/white"
                      android:textSize="17sp"
                      android:layout_marginRight="20dp"
                      android:layout_marginTop="15dp"
                      app:layout_constraintRight_toRightOf="parent"
                      app:layout_constraintTop_toTopOf="parent"/>

                  <TextView
                      android:id="@+id/totalPrice"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginRight="30dp"
                      android:text="₪ 0"
                      android:textColor="@color/light_red"
                      android:textSize="30sp"
                      android:textStyle="bold"
                      app:layout_constraintRight_toRightOf="parent"
                      app:layout_constraintTop_toBottomOf="@id/txtTotal" />

                  <TextView
                      android:id="@+id/txtTotal2"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="اجمالي أرصدة الزبائن : "
                      android:textColor="@color/white"
                      android:textSize="17sp"
                      android:layout_marginTop="5dp"
                      app:layout_constraintBottom_toBottomOf="parent"
                      android:layout_marginBottom="15dp"
                      android:layout_marginRight="20dp"
                      app:layout_constraintRight_toRightOf="parent"
                      app:layout_constraintTop_toBottomOf="@id/totalPrice"/>

                  <TextView
                      android:id="@+id/totalPrice2"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="₪ 0"
                      android:textColor="@color/l_blue"
                      android:textSize="17sp"
                      android:layout_marginTop="5dp"
                      app:layout_constraintTop_toBottomOf="@id/totalPrice"
                      app:layout_constraintRight_toLeftOf="@id/txtTotal2"

                       />

            </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.cardview.widget.CardView>


      <EditText
          android:id="@+id/editSearch"
          android:layout_width="match_parent"
          android:layout_height="45dp"
          android:layout_marginHorizontal="22dp"
          android:layout_marginTop="10dp"
          android:textDirection="rtl"
          android:background="@drawable/search_shape"
          android:hint="ابحث بالاسم أو رقم الجوال"
          android:paddingHorizontal="20dp"
          android:textColor="@color/green"
          android:textColorHint="@color/gray"
          android:textSize="15sp"
          app:layout_constraintRight_toRightOf="parent"
          app:layout_constraintTop_toBottomOf="@id/cardTotal1"
          tools:ignore="TouchTargetSizeCheck" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvAccounts"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_marginTop="10dp"
          android:scrollbars="vertical"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintLeft_toLeftOf="parent"
          app:layout_constraintRight_toRightOf="parent"
          app:layout_constraintTop_toBottomOf="@id/editSearch"
          tools:listitem="@layout/item_account" />

      <TextView
          android:id="@+id/tvEmptyState"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-condensed-light"
          android:gravity="center"
          android:text="لا يوجد زبائن حالياً.. اضغط (+) لإضافة زبون جديد"
          android:textColor="#8C8C8C"
          android:textSize="16sp"
          android:textStyle="bold"
          android:visibility="gone"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintLeft_toLeftOf="parent"
          app:layout_constraintRight_toRightOf="parent"
          app:layout_constraintTop_toTopOf="parent" />
      <androidx.cardview.widget.CardView
          android:id="@+id/floatingAddCustomer"
          android:layout_width="55dp"
          android:layout_height="55dp"
          android:layout_margin="16dp"
          app:cardCornerRadius="30dp"
          app:cardElevation="15dp"
          app:cardBackgroundColor="@color/green"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintLeft_toLeftOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_input_add"
                android:padding="16dp"
                app:tint="@color/white" />

      </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>